#include <zephyr/dt-bindings/pinctrl/esp32c6-pinctrl.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
    chosen {
        zephyr,console = &usb_serial;
        zephyr,shell-uart = &usb_serial;
    };

    /* Phase markers for PPK2 current measurements (power_marker.h).
     * Only driven when APP_POWER_MARKERS = 1. PPK2 logic port D0-D3. */
    zephyr,user {
        power-marker-gpios = <&gpio0 18 GPIO_ACTIVE_HIGH>,
                             <&gpio0 19 GPIO_ACTIVE_HIGH>,
                             <&gpio0 20 GPIO_ACTIVE_HIGH>,
                             <&gpio0 21 GPIO_ACTIVE_HIGH>;
    };
};

&usb_serial {
    status = "okay";
};

/* RTC timer wakes the chip from light sleep (power_mgmt.c) */
&rtc_timer {
    status = "okay";
    wakeup-source;
};

/* Turned off: on in the board's default devicetree, but not used by this
 * application. Their drivers are not started, which keeps boot (every deep
 * sleep wake is a boot) short and avoids powering blocks we don't need.
 *   coretemp     chip temperature sensor (was enabled here, never read)
 *   uart0        the console is on usb_serial; the modem is on uart1
 *   i2c0, spi2   no I2C/SPI devices on the Edge
 *   esp32_bt_hci, ieee802154   no Bluetooth or Thread/Zigbee radio
 *   mbox0        mailbox to the LP core, which is not used (see report)
 */
&coretemp {
    status = "disabled";
};

&uart0 {
    status = "disabled";
};

&i2c0 {
    status = "disabled";
};

&spi2 {
    status = "disabled";
};

&esp32_bt_hci {
    status = "disabled";
};

&ieee802154 {
    status = "disabled";
};

&mbox0 {
    status = "disabled";
};

/* SIM7080G (M5Stamp CatM) cellular modem: ESP TX = GPIO23, RX = GPIO22 */
&pinctrl {
    uart1_modem: uart1_modem {
        group1 {
            pinmux = <UART1_TX_GPIO23>;
            output-high;
        };
        group2 {
            pinmux = <UART1_RX_GPIO22>;
            bias-pull-up;
        };
    };
};

&uart1 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart1_modem>;
    pinctrl-names = "default";
};
