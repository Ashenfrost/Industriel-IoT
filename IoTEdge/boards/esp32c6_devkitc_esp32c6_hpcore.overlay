#include <zephyr/dt-bindings/pinctrl/esp32c6-pinctrl.h>

/ {
    chosen {
        zephyr,console = &usb_serial;
        zephyr,shell-uart = &usb_serial;
    };
};

&usb_serial {
    status = "okay";
};

&coretemp {
    status = "okay";
    range-min = <(-10)>;
    range-max = <80>;
};

/* SIM7080G (M5Stamp CatM) cellular modem: ESP TX = GPIO23, RX = GPIO22 */
&pinctrl {
    uart1_modem: uart1_modem {
        group1 {
            pinmux = <UART1_TX_GPIO23>;
            output-high;
        };
        group2 {
            pinmux = <UART1_RX_GPIO22>;
            bias-pull-up;
        };
    };
};

&uart1 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart1_modem>;
    pinctrl-names = "default";
};
