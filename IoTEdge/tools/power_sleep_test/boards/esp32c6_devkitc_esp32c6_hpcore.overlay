#include <zephyr/dt-bindings/pinctrl/esp32c6-pinctrl.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
    chosen {
        zephyr,console = &usb_serial;
        zephyr,shell-uart = &usb_serial;
    };

    /* Phase markers for PPK2 current measurements (power_marker.h).
     * Only driven when APP_POWER_MARKERS = 1. PPK2 logic port D0-D3. */
    zephyr,user {
        power-marker-gpios = <&gpio0 18 GPIO_ACTIVE_HIGH>,
                             <&gpio0 19 GPIO_ACTIVE_HIGH>,
                             <&gpio0 20 GPIO_ACTIVE_HIGH>,
                             <&gpio0 21 GPIO_ACTIVE_HIGH>;
    };
};

&usb_serial {
    status = "okay";
};

/* RTC timer wakes the chip from light sleep (as in Zephyr's light_sleep sample) */
&rtc_timer {
    status = "okay";
    wakeup-source;
};

&coretemp {
    status = "okay";
    range-min = <(-10)>;
    range-max = <80>;
};

/* SIM7080G (M5Stamp CatM) cellular modem: ESP TX = GPIO23, RX = GPIO22 */
&pinctrl {
    uart1_modem: uart1_modem {
        group1 {
            pinmux = <UART1_TX_GPIO23>;
            output-high;
        };
        group2 {
            pinmux = <UART1_RX_GPIO22>;
            bias-pull-up;
        };
    };
};

&uart1 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart1_modem>;
    pinctrl-names = "default";
};
